#!/usr/bin/env bash

set -euo pipefail

: "${GH_SHIM_STATE_DIR:?GH_SHIM_STATE_DIR is required}"
: "${GH_FIXTURE:?GH_FIXTURE is required}"

mkdir -p -- "$GH_SHIM_STATE_DIR"
printf '%q ' "$@" >>"$GH_SHIM_STATE_DIR/gh.log"
printf '\n' >>"$GH_SHIM_STATE_DIR/gh.log"

emit_candidates() {
  local numbers=$1
  local draft=$2
  local limit=$3
  local repository=${GH_REPOSITORY:-octo/example}

  if [[ -z "$numbers" ]]; then
    printf '[]\n'
    return
  fi

  printf '%s\n' "${numbers//,/$'\n'}" |
    jq -Rsc \
      --arg repository "$repository" \
      --argjson draft "$draft" \
      --argjson limit "$limit" '
        split("\n")
        | map(select(length > 0) | tonumber)
        | map({
            number: .,
            repository: {nameWithOwner: $repository},
            url: ("https://github.com/" + $repository + "/pull/" + (tostring)),
            isDraft: $draft
          })
        | .[:$limit]
      '
}

append_posted_review() {
  local fixture=$1
  local number=$2
  local posted_file posted_comment_file
  local posted_bodies='[]'
  local posted_comments='[]'

  if [[ "${GH_INCLUDE_POSTED_MARKER:-1}" == 1 ]]; then
    for posted_file in "$GH_SHIM_STATE_DIR"/posted-"$number"-*.md; do
      [[ -s "$posted_file" ]] || continue
      posted_bodies=$(jq -c --rawfile body "$posted_file" '. + [$body]' \
        <<<"$posted_bodies")
    done
    for posted_comment_file in "$GH_SHIM_STATE_DIR"/baseline-"$number"-*.md; do
      [[ -s "$posted_comment_file" ]] || continue
      posted_comments=$(jq -c --rawfile body "$posted_comment_file" '. + [$body]' \
        <<<"$posted_comments")
    done
  fi

  jq \
    --argjson bodies "$posted_bodies" \
    --argjson baseline_bodies "$posted_comments" '
      .reviews += [
        $bodies
        | to_entries[]
        | {
            id: ("PRR_posted_" + (.key | tostring)),
            author: {login: "sentry-bot"},
            submittedAt: (
              "2026-07-29T12:00:0" + (.key | tostring) + "Z"
            ),
            state: "COMMENTED",
            body: .value,
            commit: {oid: .headRefOid}
          }
      ]
      | .comments += [
          $baseline_bodies
          | to_entries[]
          | {
              id: ("PRC_baseline_" + (.key | tostring)),
              author: {login: "sentry-bot"},
              createdAt: (
                "2026-07-29T12:30:0" + (.key | tostring) + "Z"
              ),
              updatedAt: (
                "2026-07-29T12:30:0" + (.key | tostring) + "Z"
              ),
              body: .value
            }
        ]
    ' "$fixture"
}

case "${1:-} ${2:-}" in
  "api user")
    printf 'sentry-bot\n'
    ;;
  "api graphql")
    if [[ -z "${GH_REVIEW_THREAD_RESOLVED:-}" ]]; then
      review_threads='[]'
    else
      review_threads=$(jq -cn \
        --argjson resolved "$GH_REVIEW_THREAD_RESOLVED" '
          [{
            id: "PRRT_kwDOexample",
            isResolved: $resolved,
            isOutdated: false
          }]
        ')
    fi
    jq -cn --argjson review_threads "$review_threads" '
      [{
        data: {
          repository: {
            pullRequest: {
              reviewThreads: {
                nodes: $review_threads,
                pageInfo: {
                  hasNextPage: false,
                  endCursor: null
                }
              }
            }
          }
        }
      }]
    '
    ;;
  "search prs")
    search_query=${3:-}
    search_limit=30
    shift 3
    while (($#)); do
      if [[ "$1" == "--limit" ]]; then
        search_limit=${2:?missing search limit}
        shift 2
      else
        shift
      fi
    done

    if [[ "$search_query" == "draft:false" ]]; then
      if [[ -n "${GH_READY_SEARCH_FIXTURE:-}" ]]; then
        jq --argjson limit "$search_limit" '.[:$limit]' \
          "$GH_READY_SEARCH_FIXTURE"
      else
        emit_candidates "${GH_READY_NUMBERS:-1}" false "$search_limit"
      fi
    elif [[ "$search_query" == "draft:true" ]]; then
      emit_candidates "${GH_DRAFT_NUMBERS:-}" true "$search_limit"
    else
      printf 'unexpected search query\n' >&2
      exit 2
    fi
    ;;
  "pr view")
    number=${3:?missing PR number}
    if [[ "${GH_FAIL_PR:-}" == "$number" ]]; then
      printf 'simulated PR metadata failure\n' >&2
      exit 1
    fi

    fixture_variable="GH_FIXTURE_$number"
    fixture=${!fixture_variable:-$GH_FIXTURE}
    view_count_file="$GH_SHIM_STATE_DIR/view-count-$number"
    view_count=0
    [[ -f "$view_count_file" ]] && view_count=$(<"$view_count_file")
    ((view_count += 1))
    printf '%s\n' "$view_count" >"$view_count_file"

    append_posted_review "$fixture" "$number" |
      jq --argjson number "$number" \
        --arg repository "${GH_REPOSITORY:-octo/example}" '
          .number = $number
          | .url = ("https://github.com/" + $repository + "/pull/" + ($number | tostring))
        ' |
      if [[ "${GH_RACE_HEAD:-0}" == 1 && "$view_count" -gt 1 ]]; then
        jq '.headRefOid = "cccccccccccccccccccccccccccccccccccccccc"'
      elif [[ "${GH_RACE_ACTIVITY:-0}" == 1 && "$view_count" -gt 1 ]]; then
        jq '.comments += [{
          id: "comment-race",
          author: {login: "reviewer"},
          createdAt: "2026-07-29T13:00:00Z",
          updatedAt: "2026-07-29T13:00:00Z",
          body: "New review input arrived while Oracle was running."
        }]'
      else
        jq .
      fi
    ;;
  "pr diff")
    if [[ "${GH_DIFF_FAIL:-0}" == 1 ]]; then
      printf 'simulated diff failure\n' >&2
      exit 1
    fi
    diff_count_file="$GH_SHIM_STATE_DIR/diff-count"
    diff_count=0
    [[ -f "$diff_count_file" ]] && diff_count=$(<"$diff_count_file")
    ((diff_count += 1))
    printf '%s\n' "$diff_count" >"$diff_count_file"

    printf '%s\n' "$(<"${GH_DIFF_FIXTURE:?GH_DIFF_FIXTURE is required}")"
    if [[ "${GH_RACE_DIFF:-0}" == 1 && "$diff_count" -gt 1 ]]; then
      printf '+base branch changed during review\n'
    fi
    ;;
  "pr review")
    number=${3:?missing PR number}
    shift 3
    body_file=""
    while (($#)); do
      if [[ "$1" == "--body-file" ]]; then
        body_file=$2
        shift 2
      else
        shift
      fi
    done
    [[ -n "$body_file" ]] || {
      printf 'missing --body-file\n' >&2
      exit 2
    }
    if [[ "${GH_REVIEW_FAIL:-0}" == 1 ]]; then
      printf 'simulated review failure\n' >&2
      exit 1
    fi
    cp -- "$body_file" "$GH_SHIM_STATE_DIR/posted-$number.md"
    count_file="$GH_SHIM_STATE_DIR/review-count"
    count=0
    [[ -f "$count_file" ]] && count=$(<"$count_file")
    ((count += 1))
    printf '%s\n' "$count" >"$count_file"
    printf -v history_file '%s/posted-%s-%06d.md' \
      "$GH_SHIM_STATE_DIR" "$number" "$count"
    cp -- "$body_file" "$history_file"
    ;;
  "pr comment")
    number=${3:?missing PR number}
    shift 3
    body_file=""
    while (($#)); do
      if [[ "$1" == "--body-file" ]]; then
        body_file=$2
        shift 2
      else
        shift
      fi
    done
    [[ -n "$body_file" ]] || {
      printf 'missing --body-file\n' >&2
      exit 2
    }
    count_file="$GH_SHIM_STATE_DIR/baseline-count"
    count=0
    [[ -f "$count_file" ]] && count=$(<"$count_file")
    ((count += 1))
    printf '%s\n' "$count" >"$count_file"
    printf -v history_file '%s/baseline-%s-%06d.md' \
      "$GH_SHIM_STATE_DIR" "$number" "$count"
    cp -- "$body_file" "$history_file"
    ;;
  "api --paginate")
    printf '[[]]\n'
    ;;
  *)
    printf 'unexpected gh invocation: %s\n' "$*" >&2
    exit 2
    ;;
esac
