#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly PROGRAM_NAME="oracle-pr-sentry"
readonly PROGRAM_VERSION="0.1.0"
readonly STATE_SCHEMA_VERSION=1
readonly MARKER_VERSION=6

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname -- "$SCRIPT_PATH")"
SOURCE_ROOT="$(dirname -- "$SCRIPT_DIR")"

DRY_RUN_CLI=""
RUN_TMP=""
RUN_TMP_OWNED=0
STATE_JSON=""
SENTRY_LOGIN=""
SNAPSHOT_MARKER=""
DECISION_REDUCER_PATH=""

log() {
  local level=$1
  shift
  printf '%s [%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$level" "$*" >&2
}

die() {
  log ERROR "$*"
  exit 1
}

usage() {
  cat << 'EOF'
Usage:
  oracle-pr-sentry [--dry-run]
  oracle-pr-sentry install
  oracle-pr-sentry enable
  oracle-pr-sentry disable
  oracle-pr-sentry uninstall
  oracle-pr-sentry --help
  oracle-pr-sentry --version

Run one discovery and review pass. Configuration is read from
${XDG_CONFIG_HOME:-$HOME/.config}/oracle-pr-sentry/env by default.

Options:
  --dry-run   Discover PRs and report decisions without Oracle, GitHub writes,
              or local state changes.
  --help      Show this help.
  --version   Show the program version.

Lifecycle commands:
  install     Install the executable, prompt, and systemd user units.
  enable      Enable and start the systemd user timer.
  disable     Disable and stop the systemd user timer.
  uninstall   Remove installed project files. Configuration and state remain.
EOF
}

require_command() {
  local command_name=$1
  command -v -- "$command_name" > /dev/null 2>&1 \
    || die "required command not found: $command_name"
}

require_unprivileged_user() {
  [[ "$(id -u)" != 0 ]] \
    || die "$PROGRAM_NAME must not run as root"
}

validate_trusted_directory() {
  local path=$1
  local owner_policy=$2
  local owner mode current_uid

  [[ -d "$path" && ! -L "$path" ]] \
    || die "trusted file directory must be a non-symlink directory: $path"

  owner=$(stat -c '%u' -- "$path") \
    || die "cannot inspect directory owner: $path"
  mode=$(stat -c '%a' -- "$path") \
    || die "cannot inspect directory permissions: $path"
  current_uid=$(id -u)

  case "$owner_policy" in
    user)
      [[ "$owner" == "$current_uid" ]] \
        || die "trusted file directory must be owned by the current user: $path"
      ;;
    user-or-root)
      [[ "$owner" == "$current_uid" || "$owner" == 0 ]] \
        || die "trusted file directory must be owned by the current user or root: $path"
      ;;
    *)
      die "internal error: unknown owner policy"
      ;;
  esac

  if ((8#$mode & 0022)); then
    die "trusted file directory must not be group- or world-writable: $path"
  fi
}

validate_trusted_file() {
  local path=$1
  local owner_policy=$2
  local owner mode current_uid

  validate_trusted_directory "$(dirname -- "$path")" "$owner_policy"
  [[ -f "$path" && ! -L "$path" ]] \
    || die "trusted file must be a regular, non-symlink file: $path"

  owner=$(stat -c '%u' -- "$path") \
    || die "cannot inspect file owner: $path"
  mode=$(stat -c '%a' -- "$path") \
    || die "cannot inspect file permissions: $path"
  current_uid=$(id -u)

  case "$owner_policy" in
    user)
      [[ "$owner" == "$current_uid" ]] \
        || die "trusted file must be owned by the current user: $path"
      ;;
    user-or-root)
      [[ "$owner" == "$current_uid" || "$owner" == 0 ]] \
        || die "trusted file must be owned by the current user or root: $path"
      ;;
    *)
      die "internal error: unknown owner policy"
      ;;
  esac

  if ((8#$mode & 0022)); then
    die "trusted file must not be group- or world-writable: $path"
  fi
}

ensure_private_directory() {
  local path=$1
  local owner

  [[ "$path" == /* ]] || die "directory path must be absolute: $path"
  [[ ! -L "$path" ]] || die "directory must not be a symlink: $path"
  install -d -m 700 -- "$path"
  owner=$(stat -c '%u' -- "$path")
  [[ "$owner" == "$(id -u)" ]] \
    || die "directory must be owned by the current user: $path"
  chmod 700 -- "$path"
}

install_project() {
  local executable_source="$SOURCE_ROOT/bin/$PROGRAM_NAME"
  local prompt_source="$SOURCE_ROOT/share/$PROGRAM_NAME/review-prompt.md"
  local service_source="$SOURCE_ROOT/systemd/$PROGRAM_NAME.service"
  local timer_source="$SOURCE_ROOT/systemd/$PROGRAM_NAME.timer"
  local reducer_source="$SOURCE_ROOT/share/$PROGRAM_NAME/decision-reducer.jq"
  local executable_target="${HOME}/.local/bin/$PROGRAM_NAME"
  local data_target="${HOME}/.local/share/$PROGRAM_NAME/review-prompt.md"
  local unit_directory="${HOME}/.config/systemd/user"

  require_command install
  require_command systemctl
  [[ -f "$executable_source" && -f "$prompt_source" &&
    -f "$service_source" && -f "$timer_source" && -f "$reducer_source" ]] \
    || die "install must be run from a complete project checkout"

  install -D -m 755 -- "$executable_source" "$executable_target"
  install -D -m 644 -- "$prompt_source" "$data_target"
  install -D -m 644 -- "$reducer_source" \
    "${HOME}/.local/share/$PROGRAM_NAME/decision-reducer.jq"
  install -D -m 644 -- "$service_source" "$unit_directory/$PROGRAM_NAME.service"
  install -D -m 644 -- "$timer_source" "$unit_directory/$PROGRAM_NAME.timer"
  systemctl --user daemon-reload

  log INFO "installed $PROGRAM_NAME under ${HOME}/.local"
  log INFO "create ${HOME}/.config/$PROGRAM_NAME/env, then run: $PROGRAM_NAME enable"
}

enable_timer() {
  require_command systemctl
  systemctl --user enable --now "$PROGRAM_NAME.timer"
  log INFO "enabled and started $PROGRAM_NAME.timer"
}

disable_timer() {
  require_command systemctl
  systemctl --user disable --now "$PROGRAM_NAME.timer"
  log INFO "disabled and stopped $PROGRAM_NAME.timer"
}

uninstall_project() {
  local unit_directory="${HOME}/.config/systemd/user"

  require_command rm
  require_command rmdir
  require_command systemctl

  systemctl --user disable --now "$PROGRAM_NAME.timer" > /dev/null 2>&1 || true
  rm -f -- \
    "${HOME}/.local/bin/$PROGRAM_NAME" \
    "${HOME}/.local/share/$PROGRAM_NAME/review-prompt.md" \
    "${HOME}/.local/share/$PROGRAM_NAME/decision-reducer.jq" \
    "$unit_directory/$PROGRAM_NAME.service" \
    "$unit_directory/$PROGRAM_NAME.timer"
  rmdir -- "${HOME}/.local/share/$PROGRAM_NAME" 2> /dev/null || true
  systemctl --user daemon-reload
  log INFO "removed installed project files; configuration and state were preserved"
}

parse_arguments() {
  COMMAND="run"

  while (($#)); do
    case "$1" in
      --dry-run)
        [[ "$COMMAND" == "run" ]] \
          || die "--dry-run cannot be combined with a lifecycle command"
        DRY_RUN_CLI=1
        ;;
      --help | -h)
        usage
        exit 0
        ;;
      --version)
        printf '%s %s\n' "$PROGRAM_NAME" "$PROGRAM_VERSION"
        exit 0
        ;;
      install | enable | disable | uninstall)
        [[ "$COMMAND" == "run" && -z "$DRY_RUN_CLI" ]] \
          || die "only one lifecycle command may be specified"
        COMMAND=$1
        ;;
      *)
        die "unknown argument: $1 (try --help)"
        ;;
    esac
    shift
  done
}

source_configuration() {
  local config_was_explicit=0
  local installed_prompt
  local checkout_prompt
  local checkout_reducer

  [[ -n "${ORACLE_PR_SENTRY_CONFIG_FILE:-}" ]] && config_was_explicit=1

  XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
  XDG_STATE_HOME="${XDG_STATE_HOME:-${HOME}/.local/state}"
  XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
  XDG_DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"

  ORACLE_PR_SENTRY_CONFIG_FILE="${ORACLE_PR_SENTRY_CONFIG_FILE:-${XDG_CONFIG_HOME}/$PROGRAM_NAME/env}"
  ORACLE_PR_SENTRY_STATE_FILE="${ORACLE_PR_SENTRY_STATE_FILE:-${XDG_STATE_HOME}/$PROGRAM_NAME/state.json}"
  ORACLE_PR_SENTRY_CACHE_DIR="${ORACLE_PR_SENTRY_CACHE_DIR:-${XDG_CACHE_HOME}/$PROGRAM_NAME}"
  ORACLE_PR_SENTRY_ORACLE_HOME_DIR="${ORACLE_PR_SENTRY_ORACLE_HOME_DIR:-${XDG_DATA_HOME}/$PROGRAM_NAME/oracle-home}"
  ORACLE_PR_SENTRY_RUNTIME_DIR="${ORACLE_PR_SENTRY_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/$PROGRAM_NAME-$(id -u)}"
  ORACLE_PR_SENTRY_LOCK_FILE="${ORACLE_PR_SENTRY_LOCK_FILE:-}"

  installed_prompt="${XDG_DATA_HOME}/$PROGRAM_NAME/review-prompt.md"
  checkout_prompt="${SOURCE_ROOT}/share/$PROGRAM_NAME/review-prompt.md"
  checkout_reducer="${SOURCE_ROOT}/share/$PROGRAM_NAME/decision-reducer.jq"
  if [[ -r "$installed_prompt" ]]; then
    ORACLE_PR_SENTRY_PROMPT_PATH="${ORACLE_PR_SENTRY_PROMPT_PATH:-$installed_prompt}"
  else
    ORACLE_PR_SENTRY_PROMPT_PATH="${ORACLE_PR_SENTRY_PROMPT_PATH:-$checkout_prompt}"
  fi
  DECISION_REDUCER_PATH=$checkout_reducer

  ORACLE_PR_SENTRY_GITHUB_OWNER="${ORACLE_PR_SENTRY_GITHUB_OWNER:-}"
  ORACLE_PR_SENTRY_GITHUB_AUTHOR="${ORACLE_PR_SENTRY_GITHUB_AUTHOR:-}"
  ORACLE_PR_SENTRY_PR_SEARCH_LIMIT="${ORACLE_PR_SENTRY_PR_SEARCH_LIMIT:-50}"
  ORACLE_PR_SENTRY_ORACLE_BIN="${ORACLE_PR_SENTRY_ORACLE_BIN:-oracle}"
  ORACLE_PR_SENTRY_ORACLE_MODEL="${ORACLE_PR_SENTRY_ORACLE_MODEL:-gpt-5.5-pro}"
  ORACLE_PR_SENTRY_ORACLE_THINKING_TIME="${ORACLE_PR_SENTRY_ORACLE_THINKING_TIME:-extended}"
  ORACLE_PR_SENTRY_ORACLE_MANUAL_LOGIN="${ORACLE_PR_SENTRY_ORACLE_MANUAL_LOGIN:-1}"
  ORACLE_PR_SENTRY_REATTACH_DELAY="${ORACLE_PR_SENTRY_REATTACH_DELAY:-}"
  ORACLE_PR_SENTRY_REATTACH_INTERVAL="${ORACLE_PR_SENTRY_REATTACH_INTERVAL:-}"
  ORACLE_PR_SENTRY_REATTACH_TIMEOUT="${ORACLE_PR_SENTRY_REATTACH_TIMEOUT:-}"
  ORACLE_PR_SENTRY_MAX_REVIEW_RUNTIME="${ORACLE_PR_SENTRY_MAX_REVIEW_RUNTIME:-1800}"
  ORACLE_PR_SENTRY_MAX_REVIEW_BODY_BYTES="${ORACLE_PR_SENTRY_MAX_REVIEW_BODY_BYTES:-60000}"
  ORACLE_PR_SENTRY_IDENTITY="${ORACLE_PR_SENTRY_IDENTITY:-oracle-pr-sentry}"
  ORACLE_PR_SENTRY_DRY_RUN="${ORACLE_PR_SENTRY_DRY_RUN:-0}"

  if [[ -e "$ORACLE_PR_SENTRY_CONFIG_FILE" ]]; then
    validate_trusted_file "$ORACLE_PR_SENTRY_CONFIG_FILE" user
    # The configuration file is deliberately a trusted, user-owned Bash source.
    # shellcheck disable=SC1090
    source "$ORACLE_PR_SENTRY_CONFIG_FILE"
    set -Eeuo pipefail
    IFS=$'\n\t'
    umask 077
  elif ((config_was_explicit)); then
    die "configured file does not exist: $ORACLE_PR_SENTRY_CONFIG_FILE"
  fi

  if [[ -n "$DRY_RUN_CLI" ]]; then
    ORACLE_PR_SENTRY_DRY_RUN=1
  fi
  ORACLE_PR_SENTRY_LOCK_FILE="${ORACLE_PR_SENTRY_LOCK_FILE:-${ORACLE_PR_SENTRY_RUNTIME_DIR}/sentry.lock}"
}

validate_positive_integer() {
  local name=$1
  local value=$2
  [[ "$value" =~ ^[1-9][0-9]*$ ]] \
    || die "$name must be a positive integer"
}

validate_optional_duration() {
  local name=$1
  local value=$2

  [[ -z "$value" || "$value" =~ ^[1-9][0-9]*(ms|s|m|h)$ ]] \
    || die "$name must be empty or a positive duration using ms, s, m, or h"
}

validate_configuration() {
  validate_positive_integer ORACLE_PR_SENTRY_PR_SEARCH_LIMIT "$ORACLE_PR_SENTRY_PR_SEARCH_LIMIT"
  validate_positive_integer ORACLE_PR_SENTRY_MAX_REVIEW_RUNTIME "$ORACLE_PR_SENTRY_MAX_REVIEW_RUNTIME"
  validate_positive_integer ORACLE_PR_SENTRY_MAX_REVIEW_BODY_BYTES "$ORACLE_PR_SENTRY_MAX_REVIEW_BODY_BYTES"
  validate_optional_duration ORACLE_PR_SENTRY_REATTACH_DELAY \
    "$ORACLE_PR_SENTRY_REATTACH_DELAY"
  validate_optional_duration ORACLE_PR_SENTRY_REATTACH_INTERVAL \
    "$ORACLE_PR_SENTRY_REATTACH_INTERVAL"
  validate_optional_duration ORACLE_PR_SENTRY_REATTACH_TIMEOUT \
    "$ORACLE_PR_SENTRY_REATTACH_TIMEOUT"

  ((ORACLE_PR_SENTRY_PR_SEARCH_LIMIT <= 1000)) \
    || die "ORACLE_PR_SENTRY_PR_SEARCH_LIMIT must not exceed 1000"
  ((ORACLE_PR_SENTRY_MAX_REVIEW_BODY_BYTES <= 65000)) \
    || die "ORACLE_PR_SENTRY_MAX_REVIEW_BODY_BYTES must not exceed 65000"

  [[ "$ORACLE_PR_SENTRY_DRY_RUN" == 0 || "$ORACLE_PR_SENTRY_DRY_RUN" == 1 ]] \
    || die "ORACLE_PR_SENTRY_DRY_RUN must be 0 or 1"
  [[ "$ORACLE_PR_SENTRY_ORACLE_MANUAL_LOGIN" == 0 ||
    "$ORACLE_PR_SENTRY_ORACLE_MANUAL_LOGIN" == 1 ]] \
    || die "ORACLE_PR_SENTRY_ORACLE_MANUAL_LOGIN must be 0 or 1"
  [[ "$ORACLE_PR_SENTRY_IDENTITY" =~ ^[A-Za-z0-9._-]+$ ]] \
    || die "ORACLE_PR_SENTRY_IDENTITY contains unsupported characters"

  [[ -r "$ORACLE_PR_SENTRY_PROMPT_PATH" ]] \
    || die "review prompt is not readable: $ORACLE_PR_SENTRY_PROMPT_PATH"
  validate_trusted_file "$ORACLE_PR_SENTRY_PROMPT_PATH" user-or-root
  [[ -r "$DECISION_REDUCER_PATH" ]] \
    || die "decision reducer is not readable: $DECISION_REDUCER_PATH"
  validate_trusted_file "$DECISION_REDUCER_PATH" user-or-root
}

validate_dependencies() {
  local dependency
  local dependencies=(
    gh jq "$ORACLE_PR_SENTRY_ORACLE_BIN" flock timeout sha256sum awk
    date id install stat chmod mktemp mv rm rmdir dirname readlink
    grep wc
  )

  for dependency in "${dependencies[@]}"; do
    require_command "$dependency"
  done
}

prepare_runtime() {
  local dry_run_root lock_directory state_directory

  if ((ORACLE_PR_SENTRY_DRY_RUN)); then
    dry_run_root=${TMPDIR:-/tmp}
    while [[ "$dry_run_root" != "/" && "$dry_run_root" == */ ]]; do
      dry_run_root=${dry_run_root%/}
    done
    [[ "$dry_run_root" == /* && -d "$dry_run_root" ]] \
      || die "temporary directory root must be an existing absolute directory: $dry_run_root"
    if ! RUN_TMP=$(mktemp -d -- "$dry_run_root/$PROGRAM_NAME-dry-run.XXXXXXXX"); then
      die "failed to create isolated dry-run workspace"
    fi
    [[ "$RUN_TMP" == "$dry_run_root"/"$PROGRAM_NAME"-dry-run.* &&
      -d "$RUN_TMP" && ! -L "$RUN_TMP" ]] \
      || die "dry-run workspace was created outside the temporary directory root"
    RUN_TMP_OWNED=1
    return 0
  fi

  state_directory=$(dirname -- "$ORACLE_PR_SENTRY_STATE_FILE")
  lock_directory=$(dirname -- "$ORACLE_PR_SENTRY_LOCK_FILE")
  ensure_private_directory "$state_directory"
  ensure_private_directory "$ORACLE_PR_SENTRY_CACHE_DIR"
  ensure_private_directory "$ORACLE_PR_SENTRY_ORACLE_HOME_DIR"
  ensure_private_directory "$ORACLE_PR_SENTRY_RUNTIME_DIR"
  ensure_private_directory "$lock_directory"

  exec {LOCK_FD}> "$ORACLE_PR_SENTRY_LOCK_FILE"
  if ! flock -n "$LOCK_FD"; then
    log INFO "another sentry invocation holds the global lock; exiting"
    exit 0
  fi

  RUN_TMP=$(mktemp -d -- "$ORACLE_PR_SENTRY_RUNTIME_DIR/run.XXXXXXXX")
  [[ "$RUN_TMP" == "$ORACLE_PR_SENTRY_RUNTIME_DIR"/run.* ]] \
    || die "temporary directory was created outside the runtime directory"
  RUN_TMP_OWNED=1
}

cleanup() {
  if ((RUN_TMP_OWNED)) && [[ -n "$RUN_TMP" && -d "$RUN_TMP" ]]; then
    rm -rf -- "$RUN_TMP"
  fi
}

load_state() {
  if [[ ! -e "$ORACLE_PR_SENTRY_STATE_FILE" ]]; then
    STATE_JSON='{"version":'"$STATE_SCHEMA_VERSION"'}'
    return 0
  fi

  [[ -f "$ORACLE_PR_SENTRY_STATE_FILE" && ! -L "$ORACLE_PR_SENTRY_STATE_FILE" ]] \
    || die "state file must be a regular, non-symlink file: $ORACLE_PR_SENTRY_STATE_FILE"
  [[ "$(stat -c '%u' -- "$ORACLE_PR_SENTRY_STATE_FILE")" == "$(id -u)" ]] \
    || die "state file must be owned by the current user"
  if ((ORACLE_PR_SENTRY_DRY_RUN == 0)); then
    chmod 600 -- "$ORACLE_PR_SENTRY_STATE_FILE"
  fi

  if ! jq -e '
    type == "object"
    and .version == 1
    and (keys - ["candidate_cursor", "version"] | length == 0)
    and (
      (has("candidate_cursor") | not)
      or (
        .candidate_cursor
        | type == "string"
          and test("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*$")
      )
    )
  ' "$ORACLE_PR_SENTRY_STATE_FILE" > /dev/null; then
    die "malformed or unsupported state file: $ORACLE_PR_SENTRY_STATE_FILE"
  fi
  if ! STATE_JSON=$(jq -cS . "$ORACLE_PR_SENTRY_STATE_FILE"); then
    die "failed to load state file: $ORACLE_PR_SENTRY_STATE_FILE"
  fi
}

persist_state() {
  local state_directory temporary_state

  ((ORACLE_PR_SENTRY_DRY_RUN == 0)) || return 0
  state_directory=$(dirname -- "$ORACLE_PR_SENTRY_STATE_FILE")
  temporary_state=$(mktemp -- "$state_directory/.state.XXXXXXXX")

  if ! printf '%s\n' "$STATE_JSON" | jq -S . > "$temporary_state"; then
    rm -f -- "$temporary_state"
    log ERROR "failed to serialize state"
    return 1
  fi
  chmod 600 -- "$temporary_state"
  if ! mv -f -- "$temporary_state" "$ORACLE_PR_SENTRY_STATE_FILE"; then
    rm -f -- "$temporary_state"
    log ERROR "failed to atomically replace state file"
    return 1
  fi
}

checkpoint_candidate_cursor() {
  local candidate=$1
  local key repository number updated_state

  repository=$(jq -r '.repository.nameWithOwner // ""' <<< "$candidate") \
    || return 1
  number=$(jq -r '.number // 0' <<< "$candidate") || return 1
  [[ "$repository" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ &&
    "$number" =~ ^[1-9][0-9]*$ ]] \
    || return 1
  key="$repository#$number"

  if ! updated_state=$(jq -cS --arg key "$key" \
    '.candidate_cursor = $key' <<< "$STATE_JSON"); then
    log ERROR "failed to update candidate cursor for $key"
    return 1
  fi
  STATE_JSON=$updated_state
  persist_state
}

discover_candidates() {
  local ready_file="$RUN_TMP/ready.json"
  local drafts_file="$RUN_TMP/drafts.json"
  local candidates_file="$RUN_TMP/candidates.json"
  local candidate_cursor
  local common_args=(
    --owner "$ORACLE_PR_SENTRY_GITHUB_OWNER"
    --author "$ORACLE_PR_SENTRY_GITHUB_AUTHOR"
    --state open
    --archived=false
    --limit "$ORACLE_PR_SENTRY_PR_SEARCH_LIMIT"
    --sort updated
    --order desc
    --json "number,repository,url,isDraft,updatedAt"
  )

  if ! gh search prs "draft:false" "${common_args[@]}" > "$ready_file"; then
    log ERROR "GitHub ready-PR discovery failed"
    return 1
  fi
  if ! gh search prs "draft:true" "${common_args[@]}" > "$drafts_file"; then
    log ERROR "GitHub draft observation failed"
    return 1
  fi

  if ! jq -e 'type == "array"' "$ready_file" "$drafts_file" > /dev/null; then
    log ERROR "GitHub discovery returned invalid JSON"
    return 1
  fi

  candidate_cursor=$(jq -r '.candidate_cursor // ""' <<< "$STATE_JSON") \
    || return 1
  if ! jq -sS --arg candidate_cursor "$candidate_cursor" '
    ((
      [.[0][] | . + {_search_eligible: true}]
      + [.[1][] | . + {_search_eligible: false}]
    )
    | sort_by([.repository.nameWithOwner, .number, ._search_eligible])
    | group_by([.repository.nameWithOwner, .number])
    | map(last)
    | sort_by(.updatedAt)
    | reverse) as $candidates
    | (
        $candidates
        | map(.repository.nameWithOwner + "#" + (.number | tostring))
        | index($candidate_cursor)
      ) as $cursor_index
    | if $cursor_index == null
      then $candidates
      else (
        $candidates[($cursor_index + 1):]
        + $candidates[:($cursor_index + 1)]
      )
      end
  ' "$ready_file" "$drafts_file" > "$candidates_file"; then
    log ERROR "failed to normalize GitHub discovery results"
    return 1
  fi

  printf '%s\n' "$candidates_file"
}

collect_snapshot() {
  local repository=$1
  local number=$2
  local work_directory=$3
  local raw_pr="$work_directory/pr.json"
  local issue_comment_pages="$work_directory/issue-comments.json"
  local review_pages="$work_directory/reviews.json"
  local review_comment_pages="$work_directory/review-comments.json"
  local review_thread_pages="$work_directory/review-threads.json"
  local check_pages="$work_directory/check-contexts.json"
  local diff_file="$work_directory/pr.diff"
  local snapshot_file="$work_directory/snapshot.json"
  local marker_prefix="<!-- $PROGRAM_NAME:v"
  local repository_owner=${repository%%/*}
  local repository_name=${repository#*/}
  local check_contexts_query
  local issue_comments_query
  local reviews_query
  local review_threads_query
  local diff_digest head_sha

  if ! gh pr view "$number" --repo "$repository" --json \
    number,url,title,body,baseRefName,headRefName,headRefOid,isDraft,state,author,files \
    > "$raw_pr"; then
    log ERROR "failed to collect PR metadata for $repository#$number"
    return 1
  fi

  if ! head_sha=$(jq -r '.headRefOid // ""' "$raw_pr") \
    || [[ ! "$head_sha" =~ ^[0-9A-Fa-f]{40,64}$ ]]; then
    log ERROR "GitHub returned an invalid head SHA for $repository#$number"
    return 1
  fi

  # shellcheck disable=SC2016  # GraphQL variables must remain literal here.
  reviews_query='
    query(
      $owner: String!,
      $name: String!,
      $number: Int!,
      $endCursor: String
    ) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $number) {
          reviews(
            first: 100,
            after: $endCursor,
            states: [
              APPROVED,
              CHANGES_REQUESTED,
              COMMENTED,
              DISMISSED,
              PENDING
            ]
          ) {
            nodes {
              id
              fullDatabaseId
              author {
                login
              }
              submittedAt
              state
              body
              commit {
                oid
              }
            }
            pageInfo {
              hasNextPage
              endCursor
            }
          }
        }
      }
    }
  '
  if ! gh api graphql --paginate --slurp \
    -f query="$reviews_query" \
    -F owner="$repository_owner" \
    -F name="$repository_name" \
    -F number="$number" > "$review_pages"; then
    log ERROR "failed to collect reviews for $repository#$number"
    return 1
  fi
  if ! jq -e '
    type == "array"
    and length > 0
    and all(
      .[];
      (.data.repository.pullRequest.reviews.nodes | type) == "array"
      and all(
        .data.repository.pullRequest.reviews.nodes[];
        (.id | type) == "string"
        and (.fullDatabaseId | type) == "string"
        and (.fullDatabaseId | test("^[1-9][0-9]*$"))
        and (
          .author == null
          or (.author.login | type) == "string"
        )
        and (.state | type) == "string"
        and (
          if .state == "PENDING"
          then .submittedAt == null
          else (.submittedAt | type) == "string"
          end
        )
        and (.body | type) == "string"
        and (
          .commit == null
          or (
            (.commit.oid | type) == "string"
            and (.commit.oid | test("^[0-9A-Fa-f]{40,64}$"))
          )
        )
      )
    )
  ' "$review_pages" > /dev/null; then
    log ERROR "GitHub returned invalid reviews for $repository#$number"
    return 1
  fi

  # shellcheck disable=SC2016  # GraphQL variables must remain literal here.
  issue_comments_query='
    query(
      $owner: String!,
      $name: String!,
      $number: Int!,
      $endCursor: String
    ) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $number) {
          comments(first: 100, after: $endCursor) {
            nodes {
              id
              author {
                login
              }
              createdAt
              updatedAt
              body
            }
            pageInfo {
              hasNextPage
              endCursor
            }
          }
        }
      }
    }
  '
  if ! gh api graphql --paginate --slurp \
    -f query="$issue_comments_query" \
    -F owner="$repository_owner" \
    -F name="$repository_name" \
    -F number="$number" > "$issue_comment_pages"; then
    log ERROR "failed to collect issue comments for $repository#$number"
    return 1
  fi
  if ! jq -e '
    type == "array"
    and length > 0
    and all(
      .[];
      (.data.repository.pullRequest.comments.nodes | type) == "array"
      and all(
        .data.repository.pullRequest.comments.nodes[];
        (.id | type) == "string"
        and (
          .author == null
          or (.author.login | type) == "string"
        )
        and (.createdAt | type) == "string"
        and (.updatedAt | type) == "string"
        and (.body | type) == "string"
      )
    )
  ' "$issue_comment_pages" > /dev/null; then
    log ERROR "GitHub returned invalid issue comments for $repository#$number"
    return 1
  fi

  # shellcheck disable=SC2016  # GraphQL variables must remain literal here.
  check_contexts_query='
    query(
      $owner: String!,
      $name: String!,
      $head: String!,
      $endCursor: String
    ) {
      repository(owner: $owner, name: $name) {
        object(expression: $head) {
          ... on Commit {
            oid
            statusCheckRollup {
              contexts(first: 100, after: $endCursor) {
                nodes {
                  __typename
                  ... on CheckRun {
                    name
                    status
                    conclusion
                    startedAt
                    completedAt
                    detailsUrl
                    checkSuite {
                      id
                      app {
                        id
                      }
                      workflowRun {
                        workflow {
                          id
                          name
                        }
                      }
                    }
                  }
                  ... on StatusContext {
                    context
                    state
                    createdAt
                    targetUrl
                    creator {
                      login
                    }
                  }
                }
                pageInfo {
                  hasNextPage
                  endCursor
                }
              }
            }
          }
        }
      }
    }
  '
  if ! gh api graphql --paginate --slurp \
    -f query="$check_contexts_query" \
    -F owner="$repository_owner" \
    -F name="$repository_name" \
    -f head="$head_sha" > "$check_pages"; then
    log ERROR "failed to collect CI check identities for $repository#$number"
    return 1
  fi
  if ! jq -e --arg head "$head_sha" '
    type == "array"
    and length > 0
    and all(
      .[];
      .data.repository.object.oid == $head
      and (
        .data.repository.object.statusCheckRollup == null
        or (
          (.data.repository.object.statusCheckRollup.contexts.nodes | type) == "array"
          and all(
            .data.repository.object.statusCheckRollup.contexts.nodes[];
            if .__typename == "CheckRun"
            then
              (.name | type) == "string"
              and (.status | type) == "string"
              and (.conclusion == null or (.conclusion | type) == "string")
              and (.checkSuite.id | type) == "string"
              and (
                .checkSuite.app == null
                or (.checkSuite.app.id | type) == "string"
              )
              and (
                .checkSuite.workflowRun == null
                or (
                  (.checkSuite.workflowRun.workflow.id | type) == "string"
                  and (.checkSuite.workflowRun.workflow.name | type) == "string"
                )
              )
            elif .__typename == "StatusContext"
            then
              (.context | type) == "string"
              and (.state | type) == "string"
              and (
                .creator == null
                or (.creator.login | type) == "string"
              )
            else false
            end
          )
        )
      )
    )
  ' "$check_pages" > /dev/null; then
    log ERROR "GitHub returned invalid CI check identities for $repository#$number"
    return 1
  fi

  if ! gh api --paginate --slurp \
    "repos/$repository/pulls/$number/comments?per_page=100" \
    > "$review_comment_pages"; then
    log ERROR "failed to collect inline review discussion for $repository#$number"
    return 1
  fi

  # shellcheck disable=SC2016  # GraphQL variables must remain literal here.
  review_threads_query='
    query(
      $owner: String!,
      $name: String!,
      $number: Int!,
      $endCursor: String
    ) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $number) {
          reviewThreads(first: 100, after: $endCursor) {
            nodes {
              id
              isResolved
              isOutdated
              comments(first: 1) {
                nodes {
                  pullRequestReview {
                    state
                  }
                }
              }
            }
            pageInfo {
              hasNextPage
              endCursor
            }
          }
        }
      }
    }
  '
  if ! gh api graphql --paginate --slurp \
    -f query="$review_threads_query" \
    -F owner="$repository_owner" \
    -F name="$repository_name" \
    -F number="$number" > "$review_thread_pages"; then
    log ERROR "failed to collect review-thread state for $repository#$number"
    return 1
  fi
  if ! jq -e '
    type == "array"
    and length > 0
    and all(
      .[];
      (.data.repository.pullRequest.reviewThreads.nodes | type) == "array"
      and all(
        .data.repository.pullRequest.reviewThreads.nodes[];
        (.id | type) == "string"
        and (.isResolved | type) == "boolean"
        and (.isOutdated | type) == "boolean"
        and (.comments.nodes | type) == "array"
        and (.comments.nodes | length) == 1
        and (
          .comments.nodes[0].pullRequestReview == null
          or (
            .comments.nodes[0].pullRequestReview.state
            | type
          ) == "string"
        )
      )
    )
  ' "$review_thread_pages" > /dev/null; then
    log ERROR "GitHub returned invalid review-thread state for $repository#$number"
    return 1
  fi

  if ! gh pr diff "$number" --repo "$repository" > "$diff_file"; then
    log ERROR "failed to collect PR diff for $repository#$number"
    return 1
  fi
  if ! diff_digest=$(sha256sum "$diff_file" | awk '{print $1}'); then
    log ERROR "failed to hash PR diff for $repository#$number"
    return 1
  fi

  if ! jq -e \
    --arg repository "$repository" \
    --arg sentry_login "$SENTRY_LOGIN" \
    --arg marker_prefix "$marker_prefix" \
    --arg sentry_identity "$ORACLE_PR_SENTRY_IDENTITY" \
    --arg diff_digest "$diff_digest" \
    --slurpfile check_pages "$check_pages" \
    --slurpfile issue_comment_pages "$issue_comment_pages" \
    --slurpfile review_pages "$review_pages" \
    --slurpfile review_comment_pages "$review_comment_pages" \
    --slurpfile review_thread_pages "$review_thread_pages" '
      def text:
        (. // "") | tostring;
      def parse_marker:
        (try (
          .body
          | capture(
              "(?:^|\\n)<!-- oracle-pr-sentry:v6 payload=(?<encoded>[A-Za-z0-9+/]+={0,2}) -->\\n?$"
            )
          | .encoded as $encoded
          | ($encoded | @base64d) as $decoded
          | ($decoded | fromjson) as $payload
          | select(($decoded | @base64) == $encoded)
          | select(
              ($payload | type) == "object"
              and ($payload | keys) == [
                "ci_failures",
                "context_fingerprint",
                "draft",
                "external_digest",
                "fingerprint",
                "head_sha",
                "identity",
                "input_fingerprint",
                "kind",
                "reason",
                "sequence"
              ]
              and ($payload.identity | type) == "string"
              and ($payload.identity | test("^[A-Za-z0-9._-]+$"))
              and (
                $payload.kind == "review"
                or $payload.kind == "baseline"
              )
              and (
                $payload.sequence
                | type == "number"
                and floor == .
                and . > 0
              )
              and (
                $payload.fingerprint
                | type == "string"
                and (
                  test("^[0-9a-f]{64}$")
                  or ($payload.kind == "baseline" and . == "")
                )
              )
              and (
                $payload.input_fingerprint
                | type == "string"
                and test("^[0-9a-f]{64}$")
              )
              and (
                $payload.context_fingerprint
                | type == "string"
                and test("^[0-9a-f]{64}$")
              )
              and (
                $payload.external_digest
                | type == "string"
                and test("^[0-9a-f]{64}$")
              )
              and (
                $payload.head_sha
                | type == "string"
                and test("^[0-9A-Fa-f]{40,64}$")
              )
              and ($payload.draft | type) == "boolean"
              and ($payload.ci_failures | type) == "array"
              and all(
                $payload.ci_failures[];
                type == "object"
                and keys == ["name", "workflow"]
                and (.name | type) == "string"
                and (.workflow | type) == "string"
              )
              and (
                $payload.ci_failures
                == (
                  $payload.ci_failures
                  | map({name, workflow})
                  | unique_by([.workflow, .name])
                )
              )
              and (
                if $payload.kind == "review"
                then
                  ($payload.draft | not)
                  and (
                    $payload.reason == "new-pr"
                    or $payload.reason == "draft-to-ready"
                    or $payload.reason == "head-sha-changed"
                    or $payload.reason == "ci-failure"
                    or $payload.reason == "external-activity"
                    or $payload.reason == "review-input-changed"
                  )
                else
                  $payload.fingerprint == ""
                  and $payload.reason == null
                end
              )
            )
          | {
              ci_failures: $payload.ci_failures,
              context_fingerprint: $payload.context_fingerprint,
              draft: $payload.draft,
              external_digest: $payload.external_digest,
              fingerprint: $payload.fingerprint,
              head_sha: $payload.head_sha,
              identity: $payload.identity,
              input_fingerprint: $payload.input_fingerprint,
              kind: $payload.kind,
              reason: $payload.reason,
              sequence: $payload.sequence
            } as $canonical
          | select(($canonical | tojson) == $decoded)
          | $canonical + {
              marker: (
                "<!-- oracle-pr-sentry:v6 payload=" + $encoded + " -->"
              )
            }
        ) catch null) // null;
      def trusted_marker:
        . as $activity
        | if $activity.author != $sentry_login
            or ($activity.body | indices($marker_prefix) | length) != 1
          then null
          else
            ($activity | parse_marker) as $marker
            | if $marker != null and $marker.identity == $sentry_identity
              then $marker
              else null
              end
          end;

      (
        $check_pages
        | flatten
        | map(
            .data.repository.object.statusCheckRollup.contexts.nodes // []
          )
        | flatten
      ) as $check_contexts
      | (
          $issue_comment_pages
          | flatten
          | map(.data.repository.pullRequest.comments.nodes)
          | flatten
        ) as $issue_comments
      | (
          $review_pages
          | flatten
          | map(.data.repository.pullRequest.reviews.nodes)
          | flatten
        ) as $all_reviews
      | (
          $all_reviews
          | map(select(.state != "PENDING"))
        ) as $reviews
      | (
          $all_reviews
          | map(select(.state == "PENDING") | .fullDatabaseId)
          | unique
        ) as $pending_review_ids
      | (
          $review_comment_pages
          | flatten
          | map(
              select(
                (.pull_request_review_id | tostring) as $review_id
                | ($pending_review_ids | index($review_id) | not)
              )
            )
        ) as $inline_comments
      | (
          $review_thread_pages
          | flatten
          | map(.data.repository.pullRequest.reviewThreads.nodes)
          | flatten
          | map(
              select(
                .comments.nodes[0].pullRequestReview.state != "PENDING"
              )
            )
          | map({
              kind: "review_thread",
              id: (.id | text),
              author: "",
              created_at: "",
              updated_at: "",
              state: "",
              path: "",
              line: null,
              commit_id: "",
              body: "",
              is_resolved: .isResolved,
              is_outdated: .isOutdated
            })
          | sort_by(.id)
        ) as $review_threads
      | (
          [
            $reviews[] | {
              kind: "review",
              id: (.id | text),
              author: (.author.login | text),
              created_at: (.submittedAt | text),
              updated_at: "",
              state: (.state | text),
              path: "",
              line: null,
              commit_id: (.commit.oid | text),
              body: (.body | text)
            }
          ]
          + [
            $issue_comments[] | {
              kind: "comment",
              id: (.id | text),
              author: (.author.login | text),
              created_at: (.createdAt | text),
              updated_at: (.updatedAt | text),
              state: "",
              path: "",
              line: null,
              commit_id: "",
              body: (.body | text)
            }
          ]
          + [
            $inline_comments[] | {
              kind: "review_comment",
              id: (.id | text),
              author: (.user.login | text),
              created_at: (.created_at | text),
              updated_at: (.updated_at | text),
              state: "",
              path: (.path | text),
              line: (.line // .original_line),
              commit_id: (.commit_id | text),
              body: (.body | text)
            }
          ]
          + $review_threads
          | sort_by([.created_at, .kind, .id])
        ) as $activities
      | {
          schema_version: 1,
          repository: $repository,
          number: .number,
          key: ($repository + "#" + (.number | tostring)),
          url: .url,
          title: (.title | text),
          body: (.body | text),
          author: (.author.login | text),
          state: ((.state | text) | ascii_upcase),
          draft: .isDraft,
          base: {
            ref: (.baseRefName | text)
          },
          head: {
            ref: (.headRefName | text),
            sha: (.headRefOid | text)
          },
          diff: {
            sha256: $diff_digest
          },
          checks: [
            $check_contexts[]
            | if .__typename == "CheckRun"
              then {
                name: (.name | text),
                workflow: (.checkSuite.workflowRun.workflow.name | text),
                producer: {
                  kind: "check_run",
                  workflow_id: (.checkSuite.workflowRun.workflow.id | text),
                  check_suite_id: (.checkSuite.id | text),
                  app_id: (.checkSuite.app.id | text)
                },
                status: (.status | text | ascii_upcase),
                result: (.conclusion | text | ascii_upcase),
                started_at: (.startedAt | text),
                completed_at: (.completedAt | text),
                details_url: (.detailsUrl | text)
              }
              else {
                name: (.context | text),
                workflow: "",
                producer: {
                  kind: "status_context",
                  actor: (.creator.login | text)
                },
                status: (
                  if .state == "PENDING" or .state == "EXPECTED"
                  then "IN_PROGRESS"
                  else "COMPLETED"
                  end
                ),
                result: (.state | text | ascii_upcase),
                started_at: (.createdAt | text),
                completed_at: "",
                details_url: (.targetUrl | text)
              }
              end
          ] | sort_by([(.producer | tojson), .name, .details_url]),
          reviews: [
            $activities[] | select(.kind == "review")
          ],
          comments: [
            $activities[] | select(.kind == "comment")
          ],
          review_comments: [
            $activities[] | select(.kind == "review_comment")
          ],
          review_threads: $review_threads,
          external_activity: [
            $activities[] | select((trusted_marker) == null)
          ],
          publications: [
            $activities[]
            | . as $activity
            | (trusted_marker) as $marker
            | $marker
            | select(. != null)
            | . + {created_at: $activity.created_at}
          ],
          files: [
            (.files // [])[] | {
              path: (.path | text),
              additions: (.additions // 0),
              deletions: (.deletions // 0)
            }
          ] | sort_by(.path)
        }
    ' "$raw_pr" > "$snapshot_file"; then
    log ERROR "failed to normalize snapshot for $repository#$number"
    return 1
  fi

  if ! jq -e '
    .schema_version == 1
    and (.repository | type == "string")
    and (.number | type == "number" and floor == . and . > 0)
    and (.key | type == "string")
    and (.url | type == "string")
    and (.title | type == "string")
    and (.body | type == "string")
    and (.state | type == "string")
    and (.draft | type == "boolean")
    and (.base.ref | type == "string")
    and (.head.sha | type == "string" and test("^[0-9A-Fa-f]{40,64}$"))
    and (.diff.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
    and (.checks | type == "array")
    and all(.checks[]; (.producer | type) == "object")
    and (.external_activity | type == "array")
    and (.review_threads | type == "array")
    and (.publications | type == "array")
    and (.files | type == "array")
  ' "$snapshot_file" > /dev/null; then
    log ERROR "GitHub returned an invalid snapshot for $repository#$number"
    return 1
  fi

  SNAPSHOT_FILE=$snapshot_file
}

digest_text() {
  printf '%s' "$1" | sha256sum | awk '{print $1}'
}

event_fingerprint() {
  local input_fingerprint=$1
  local reason=$2
  local event_sequence=$3

  jq -cnS \
    --arg input_fingerprint "$input_fingerprint" \
    --arg reason "$reason" \
    --argjson event_sequence "$event_sequence" '
      {
        schema_version: 2,
        input_fingerprint: $input_fingerprint,
        reason: $reason,
        event_sequence: $event_sequence
      }
    ' | sha256sum | awk '{print $1}'
}

snapshot_facts() {
  local snapshot_file=$1

  SNAPSHOT_KEY=$(jq -r '.key' "$snapshot_file") || return 1
  SNAPSHOT_BASE_REF=$(jq -r '.base.ref' "$snapshot_file") || return 1
  SNAPSHOT_HEAD=$(jq -r '.head.sha' "$snapshot_file") || return 1
  SNAPSHOT_DIFF_DIGEST=$(jq -r '.diff.sha256' "$snapshot_file") || return 1
  SNAPSHOT_REQUIREMENTS_JSON=$(jq -cS '{title, body}' "$snapshot_file") \
    || return 1
  SNAPSHOT_DRAFT=$(jq -r '.draft' "$snapshot_file") || return 1
  SNAPSHOT_STATE=$(jq -r '.state' "$snapshot_file") || return 1
  SNAPSHOT_CI_IDENTITIES_JSON=$(jq -cS '
    def producer_key:
      (.producer | del(.check_suite_id))
      | to_entries
      | sort_by(.key)
      | from_entries
      | tojson;
    [
      .checks[]
      | select(
          .result == "FAILURE"
          or .result == "ERROR"
          or .result == "TIMED_OUT"
          or .result == "CANCELLED"
          or .result == "ACTION_REQUIRED"
          or .result == "STARTUP_FAILURE"
          or .result == "STALE"
      )
      | {workflow: producer_key, name}
    ]
    | unique_by([.workflow, .name])
  ' "$snapshot_file") || return 1
  SNAPSHOT_CI_DIGEST=$(digest_text "$SNAPSHOT_CI_IDENTITIES_JSON") || return 1
  SNAPSHOT_EXTERNAL_JSON=$(jq -cS '.external_activity' "$snapshot_file") || return 1
  SNAPSHOT_EXTERNAL_DIGEST=$(digest_text "$SNAPSHOT_EXTERNAL_JSON") || return 1
  SNAPSHOT_CONTEXT_FINGERPRINT=$(jq -cnS \
    --arg base_ref "$SNAPSHOT_BASE_REF" \
    --arg head_sha "$SNAPSHOT_HEAD" \
    --arg diff_digest "$SNAPSHOT_DIFF_DIGEST" \
    --arg external_digest "$SNAPSHOT_EXTERNAL_DIGEST" \
    --argjson requirements "$SNAPSHOT_REQUIREMENTS_JSON" '
      {
        schema_version: 2,
        base_ref: $base_ref,
        head_sha: $head_sha,
        diff_digest: $diff_digest,
        external_digest: $external_digest,
        requirements: $requirements
      }
    ' | sha256sum | awk '{print $1}') || return 1
  SNAPSHOT_FINGERPRINT=$(jq -cnS \
    --arg context_fingerprint "$SNAPSHOT_CONTEXT_FINGERPRINT" \
    --arg ci_digest "$SNAPSHOT_CI_DIGEST" \
    '
      {
        schema_version: 2,
        context_fingerprint: $context_fingerprint,
        ready: true,
        ci_digest: $ci_digest
      }
    ' | sha256sum | awk '{print $1}') || return 1
  SNAPSHOT_INPUT_FINGERPRINT=$SNAPSHOT_FINGERPRINT
  SNAPSHOT_EVENT_SEQUENCE=$(jq '
    (([.publications[].sequence] | max) // 0) + 1
  ' "$snapshot_file") || return 1
  SNAPSHOT_CURRENT_JSON=$(jq -cnS \
    --argjson draft "$SNAPSHOT_DRAFT" \
    --arg head_sha "$SNAPSHOT_HEAD" \
    --arg input_fingerprint "$SNAPSHOT_INPUT_FINGERPRINT" \
    --arg context_fingerprint "$SNAPSHOT_CONTEXT_FINGERPRINT" \
    --arg external_digest "$SNAPSHOT_EXTERNAL_DIGEST" \
    --argjson ci_failures "$SNAPSHOT_CI_IDENTITIES_JSON" '
      {
        draft: $draft,
        head_sha: $head_sha,
        input_fingerprint: $input_fingerprint,
        context_fingerprint: $context_fingerprint,
        external_digest: $external_digest,
        ci_failures: $ci_failures
      }
    ') || return 1
  SNAPSHOT_PREVIOUS_JSON=$(jq -cS '
    (
      (.publications | max_by([.sequence, .created_at]))
      // null
    )
    | if . == null
      then null
      else {
        kind,
        sequence,
        reason,
        fingerprint,
        input_fingerprint,
        context_fingerprint,
        head_sha,
        draft,
        ci_failures,
        external_digest
      }
      end
  ' "$snapshot_file") || return 1
}

build_marker() {
  local kind=$1
  local reason=$2
  local fingerprint=$3
  local sequence=$4
  local payload encoded

  payload=$(jq -cnS \
    --arg identity "$ORACLE_PR_SENTRY_IDENTITY" \
    --arg kind "$kind" \
    --arg reason "$reason" \
    --arg fingerprint "$fingerprint" \
    --arg input_fingerprint "$SNAPSHOT_INPUT_FINGERPRINT" \
    --arg context_fingerprint "$SNAPSHOT_CONTEXT_FINGERPRINT" \
    --arg head_sha "$SNAPSHOT_HEAD" \
    --argjson draft "$SNAPSHOT_DRAFT" \
    --argjson ci_failures "$SNAPSHOT_CI_IDENTITIES_JSON" \
    --arg external_digest "$SNAPSHOT_EXTERNAL_DIGEST" \
    --argjson sequence "$sequence" '
      {
        identity: $identity,
        kind: $kind,
        sequence: $sequence,
        reason: (if $kind == "review" then $reason else null end),
        fingerprint: $fingerprint,
        input_fingerprint: $input_fingerprint,
        context_fingerprint: $context_fingerprint,
        head_sha: $head_sha,
        draft: $draft,
        ci_failures: $ci_failures,
        external_digest: $external_digest
      }
    ') || return 1
  encoded=$(jq -rn --arg payload "$payload" '$payload | @base64') \
    || return 1
  printf '<!-- %s:v%s payload=%s -->\n' \
    "$PROGRAM_NAME" "$MARKER_VERSION" "$encoded"
}

snapshot_has_publication() {
  local snapshot_file=$1
  local fingerprint=$2
  local head_sha=$3

  jq -e \
    --arg fingerprint "$fingerprint" \
    --arg head_sha "$head_sha" '
      any(
        .publications[];
        .kind == "review"
        and .fingerprint == $fingerprint
        and .head_sha == $head_sha
      )
    ' "$snapshot_file" > /dev/null
}

publish_baseline() {
  local repository=$1
  local number=$2
  local work_directory=$3
  local fresh_directory="$work_directory/baseline-fresh"
  local marker_file="$work_directory/baseline-marker.md"
  local initial_current=$SNAPSHOT_CURRENT_JSON
  local initial_event_sequence=$SNAPSHOT_EVENT_SEQUENCE
  local baseline_marker

  if ! install -d -m 700 -- "$fresh_directory"; then
    log ERROR "failed to create fresh baseline-snapshot directory"
    return 1
  fi
  if ! collect_snapshot "$repository" "$number" "$fresh_directory" \
    || ! snapshot_facts "$SNAPSHOT_FILE"; then
    return 1
  fi

  if [[ "$SNAPSHOT_STATE" != "OPEN" ||
    "$SNAPSHOT_CURRENT_JSON" != "$initial_current" ]]; then
    log INFO "discarding stale baseline for $repository#$number; PR inputs changed"
    return 1
  fi
  if jq -n -e \
    --argjson current "$SNAPSHOT_CURRENT_JSON" \
    --argjson previous "$SNAPSHOT_PREVIOUS_JSON" '
      $previous != null
      and $previous.draft == $current.draft
      and $previous.head_sha == $current.head_sha
      and $previous.input_fingerprint == $current.input_fingerprint
      and $previous.context_fingerprint == $current.context_fingerprint
      and $previous.external_digest == $current.external_digest
      and $previous.ci_failures == $current.ci_failures
    ' > /dev/null; then
    log INFO "matching GitHub event appeared for $repository#$number"
    return 0
  fi
  if [[ "$SNAPSHOT_EVENT_SEQUENCE" != "$initial_event_sequence" ]]; then
    log INFO "discarding stale baseline for $repository#$number; event sequence changed"
    return 1
  fi

  if ! baseline_marker=$(build_marker \
    baseline "" "" "$initial_event_sequence"); then
    log ERROR "failed to construct baseline marker for $repository#$number"
    return 1
  fi
  if ! printf '%s\n' "$baseline_marker" > "$marker_file" \
    || ! gh pr review "$number" --repo "$repository" --comment \
      --body-file "$marker_file"; then
    log ERROR "failed to publish baseline marker for $repository#$number"
    return 1
  fi
  log INFO "published baseline marker for $repository#$number"
}

run_oracle_review() {
  local repository=$1
  local number=$2
  local snapshot_file=$3
  local work_directory=$4
  local metadata_file="$work_directory/metadata.json"
  local diff_file="$work_directory/pr.diff"
  local output_file="$work_directory/review.md"
  local prompt output_size expected_diff_digest actual_diff_digest
  local oracle_args=(
    --engine browser
    --model "$ORACLE_PR_SENTRY_ORACLE_MODEL"
    --browser-thinking-time "$ORACLE_PR_SENTRY_ORACLE_THINKING_TIME"
    --browser-timeout "${ORACLE_PR_SENTRY_MAX_REVIEW_RUNTIME}s"
    --browser-max-concurrent-tabs 1
    --browser-manual-login-profile-dir "$ORACLE_PR_SENTRY_ORACLE_HOME_DIR/browser-profile"
    --no-background
    --wait
    --write-output "$output_file"
  )

  if ((ORACLE_PR_SENTRY_ORACLE_MANUAL_LOGIN)); then
    oracle_args+=(--browser-manual-login)
  fi
  if [[ -n "$ORACLE_PR_SENTRY_REATTACH_DELAY" ]]; then
    oracle_args+=(
      --browser-auto-reattach-delay "$ORACLE_PR_SENTRY_REATTACH_DELAY"
    )
  fi
  if [[ -n "$ORACLE_PR_SENTRY_REATTACH_INTERVAL" ]]; then
    oracle_args+=(
      --browser-auto-reattach-interval "$ORACLE_PR_SENTRY_REATTACH_INTERVAL"
    )
  fi
  if [[ -n "$ORACLE_PR_SENTRY_REATTACH_TIMEOUT" ]]; then
    oracle_args+=(
      --browser-auto-reattach-timeout "$ORACLE_PR_SENTRY_REATTACH_TIMEOUT"
    )
  fi

  if ! jq -S '
    .reviews = [
      .external_activity[] | select(.kind == "review")
    ]
    | .comments = [
        .external_activity[] | select(.kind == "comment")
      ]
    | .review_comments = [
        .external_activity[] | select(.kind == "review_comment")
      ]
    | del(.publications)
  ' "$snapshot_file" > "$metadata_file"; then
    log ERROR "failed to build Oracle metadata for $repository#$number"
    return 1
  fi
  expected_diff_digest=$(jq -r '.diff.sha256' "$snapshot_file") || return 1
  if [[ ! -f "$diff_file" ]] \
    || ! actual_diff_digest=$(sha256sum "$diff_file" | awk '{print $1}') \
    || [[ "$actual_diff_digest" != "$expected_diff_digest" ]]; then
    log ERROR "collected PR diff no longer matches the snapshot for $repository#$number"
    return 1
  fi

  prompt=$(< "$ORACLE_PR_SENTRY_PROMPT_PATH")
  log INFO "invoking Oracle for $repository#$number at $SNAPSHOT_HEAD"
  if (
    cd -- "$work_directory" \
      && unset ORACLE_BROWSER_PROFILE_DIR \
      && ORACLE_HOME_DIR="$ORACLE_PR_SENTRY_ORACLE_HOME_DIR" \
        exec timeout --foreground --signal=TERM --kill-after=30s \
        "${ORACLE_PR_SENTRY_MAX_REVIEW_RUNTIME}s" \
        "$ORACLE_PR_SENTRY_ORACLE_BIN" \
        "${oracle_args[@]}" \
        --prompt "$prompt" \
        --file "$metadata_file" \
        --file "$diff_file"
  ); then
    :
  else
    local oracle_status=$?
    log ERROR "Oracle failed for $repository#$number (status $oracle_status); review remains retryable"
    return 1
  fi

  if [[ ! -s "$output_file" ]]; then
    log ERROR "Oracle produced empty or invalid Markdown for $repository#$number"
    return 1
  fi
  output_size=$(wc -c < "$output_file") || return 1
  if ((output_size > ORACLE_PR_SENTRY_MAX_REVIEW_BODY_BYTES)); then
    log ERROR "Oracle output is $output_size bytes; review limit is $ORACLE_PR_SENTRY_MAX_REVIEW_BODY_BYTES"
    return 1
  fi
  if ! jq -Rs -e 'test("\\S")' < "$output_file" > /dev/null; then
    log ERROR "Oracle produced empty or invalid Markdown for $repository#$number"
    return 1
  fi
  if grep -Fq -- "<!-- $PROGRAM_NAME:v" "$output_file"; then
    log ERROR "Oracle output contains the reserved publication marker prefix for $repository#$number"
    return 1
  fi

  ORACLE_OUTPUT_FILE=$output_file
}

publish_review() {
  local repository=$1
  local number=$2
  local work_directory=$3
  local fresh_directory="$work_directory/fresh"
  local initial_head=$SNAPSHOT_HEAD
  local initial_fingerprint=$SNAPSHOT_FINGERPRINT
  local initial_input_fingerprint=$SNAPSHOT_INPUT_FINGERPRINT
  local initial_event_sequence=$SNAPSHOT_EVENT_SEQUENCE
  local initial_marker=$SNAPSHOT_MARKER
  local publication_file="$work_directory/publication.md"
  local publication_size

  if ! install -d -m 700 -- "$fresh_directory"; then
    log ERROR "failed to create fresh-snapshot directory"
    return 1
  fi
  if ! collect_snapshot "$repository" "$number" "$fresh_directory"; then
    return 1
  fi

  local fresh_snapshot=$SNAPSHOT_FILE
  local fresh_head fresh_state fresh_draft
  fresh_head=$(jq -r '.head.sha' "$fresh_snapshot") || return 1
  fresh_state=$(jq -r '.state' "$fresh_snapshot") || return 1
  fresh_draft=$(jq -r '.draft' "$fresh_snapshot") || return 1

  if [[ "$fresh_state" != "OPEN" || "$fresh_draft" != "false" ||
    "$fresh_head" != "$initial_head" ]]; then
    log INFO "discarding stale review for $repository#$number; PR state or head changed"
    return 1
  fi

  if snapshot_has_publication "$fresh_snapshot" "$initial_fingerprint" "$initial_head"; then
    log INFO "matching GitHub marker appeared during review; reconciling local state"
    return 2
  fi

  if ! snapshot_facts "$fresh_snapshot"; then
    log ERROR "failed to calculate fresh snapshot facts for $repository#$number"
    return 1
  fi
  if [[ "$SNAPSHOT_INPUT_FINGERPRINT" != "$initial_input_fingerprint" ||
    "$SNAPSHOT_EVENT_SEQUENCE" != "$initial_event_sequence" ]]; then
    log INFO "discarding stale review for $repository#$number; review inputs changed"
    return 1
  fi
  SNAPSHOT_FINGERPRINT=$initial_fingerprint
  SNAPSHOT_MARKER=$initial_marker

  if ! {
    printf '%s\n\n' "$(< "$ORACLE_OUTPUT_FILE")"
    printf '%s\n' "$SNAPSHOT_MARKER"
  } > "$publication_file"; then
    log ERROR "failed to assemble review body for $repository#$number"
    return 1
  fi
  publication_size=$(wc -c < "$publication_file") || return 1
  if ((publication_size > ORACLE_PR_SENTRY_MAX_REVIEW_BODY_BYTES)); then
    log ERROR "review body is $publication_size bytes; limit is $ORACLE_PR_SENTRY_MAX_REVIEW_BODY_BYTES"
    return 1
  fi

  if ! gh pr review "$number" --repo "$repository" --comment --body-file "$publication_file"; then
    log ERROR "GitHub rejected the comment-only review for $repository#$number"
    return 1
  fi
  log INFO "published comment-only review for $repository#$number"
  return 0
}

process_candidate() {
  local candidate=$1
  local repository number work_directory
  local action decision reason publish_status

  repository=$(jq -r '.repository.nameWithOwner // ""' <<< "$candidate") || return 1
  number=$(jq -r '.number // 0' <<< "$candidate") || return 1
  [[ "$repository" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] \
    || {
      log ERROR "discovery returned an invalid repository identifier"
      return 1
    }
  [[ "$number" =~ ^[1-9][0-9]*$ ]] \
    || {
      log ERROR "discovery returned an invalid PR number for $repository"
      return 1
    }

  if ! work_directory=$(mktemp -d -- "$RUN_TMP/pr.XXXXXXXX"); then
    log ERROR "failed to create temporary PR workspace"
    return 1
  fi
  if ! collect_snapshot "$repository" "$number" "$work_directory"; then
    return 1
  fi
  if ! snapshot_facts "$SNAPSHOT_FILE"; then
    log ERROR "failed to calculate snapshot facts for $repository#$number"
    return 1
  fi

  if [[ "$SNAPSHOT_STATE" != "OPEN" ]]; then
    log INFO "ineligible $SNAPSHOT_KEY: PR is no longer open"
    return 0
  fi

  if ! decision=$(
    jq -cnS \
      --argjson current "$SNAPSHOT_CURRENT_JSON" \
      --argjson previous "$SNAPSHOT_PREVIOUS_JSON" '
        {current: $current, previous: $previous}
      ' \
      | jq -c -f "$DECISION_REDUCER_PATH"
  ); then
    log ERROR "failed to decide action for $SNAPSHOT_KEY"
    return 1
  fi
  action=$(jq -r '.action' <<< "$decision") || return 1
  reason=$(jq -r '.reason // ""' <<< "$decision") || return 1

  case "$action" in
    none)
      log INFO "unchanged $SNAPSHOT_KEY: no meaningful update"
      return 0
      ;;
    baseline)
      if [[ "$SNAPSHOT_DRAFT" == "true" ]]; then
        log INFO "ineligible $SNAPSHOT_KEY: draft observed"
      else
        log INFO "unchanged $SNAPSHOT_KEY: no meaningful update"
      fi
      if ((ORACLE_PR_SENTRY_DRY_RUN)); then
        log INFO "dry-run $SNAPSHOT_KEY: would publish baseline"
        return 0
      fi
      publish_baseline "$repository" "$number" "$work_directory"
      return
      ;;
    review)
      ;;
    *)
      log ERROR "decision reducer returned invalid action for $SNAPSHOT_KEY"
      return 1
      ;;
  esac

  log INFO "eligible $SNAPSHOT_KEY at $SNAPSHOT_HEAD"

  if ! SNAPSHOT_FINGERPRINT=$(event_fingerprint \
    "$SNAPSHOT_INPUT_FINGERPRINT" "$reason" "$SNAPSHOT_EVENT_SEQUENCE"); then
    log ERROR "failed to calculate event fingerprint for $SNAPSHOT_KEY"
    return 1
  fi
  if ! SNAPSHOT_MARKER=$(build_marker \
    review "$reason" "$SNAPSHOT_FINGERPRINT" "$SNAPSHOT_EVENT_SEQUENCE"); then
    log ERROR "failed to construct review marker for $SNAPSHOT_KEY"
    return 1
  fi

  if snapshot_has_publication "$SNAPSHOT_FILE" "$SNAPSHOT_FINGERPRINT" "$SNAPSHOT_HEAD"; then
    log INFO "matching GitHub marker found for $SNAPSHOT_KEY"
    return
  fi

  if ((ORACLE_PR_SENTRY_DRY_RUN)); then
    log INFO "dry-run $SNAPSHOT_KEY: would review ($reason)"
    return 0
  fi

  log INFO "scheduled $SNAPSHOT_KEY: $reason"
  if ! run_oracle_review "$repository" "$number" "$SNAPSHOT_FILE" "$work_directory"; then
    return 1
  fi

  set +e
  publish_review "$repository" "$number" "$work_directory"
  publish_status=$?
  set -e
  case "$publish_status" in
    0 | 2) return 0 ;;
    *)
      return 1
      ;;
  esac
}

run_sentry() {
  local candidates_file candidate
  local failures=0
  local processed=0
  local -a candidates

  source_configuration
  validate_configuration
  validate_dependencies
  prepare_runtime
  trap cleanup EXIT
  trap 'exit 130' INT TERM

  if ! SENTRY_LOGIN=$(gh api user --jq .login); then
    die "failed to identify the authenticated GitHub account"
  fi
  [[ "$SENTRY_LOGIN" =~ ^[A-Za-z0-9_.-]+(\[bot\])?$ ]] \
    || die "GitHub returned an invalid authenticated login"
  ORACLE_PR_SENTRY_GITHUB_OWNER="${ORACLE_PR_SENTRY_GITHUB_OWNER:-$SENTRY_LOGIN}"
  ORACLE_PR_SENTRY_GITHUB_AUTHOR="${ORACLE_PR_SENTRY_GITHUB_AUTHOR:-$SENTRY_LOGIN}"

  load_state
  if ! candidates_file=$(discover_candidates); then
    return 1
  fi
  mapfile -t candidates < <(jq -c '.[]' "$candidates_file")

  for candidate in "${candidates[@]}"; do
    ((processed += 1))
    if ((ORACLE_PR_SENTRY_DRY_RUN == 0)) \
      && ! checkpoint_candidate_cursor "$candidate"; then
      ((failures += 1))
      log ERROR "candidate rotation checkpoint failed; continuing without a durable cursor"
    fi
    if ! process_candidate "$candidate"; then
      ((failures += 1))
      log ERROR "candidate failed; continuing with remaining PRs"
    fi
  done

  log INFO "pass complete: candidates=$processed failures=$failures dry_run=$ORACLE_PR_SENTRY_DRY_RUN"
  ((failures == 0))
}

main() {
  parse_arguments "$@"
  require_unprivileged_user
  case "$COMMAND" in
    run) run_sentry ;;
    install) install_project ;;
    enable) enable_timer ;;
    disable) disable_timer ;;
    uninstall) uninstall_project ;;
  esac
}

main "$@"
