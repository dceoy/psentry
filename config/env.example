# Copy to ~/.config/psentry/env and chmod 600.
#
# psentry validates this file before sourcing it as trusted Bash.
# Keep it user-owned and non-writable by group or other users.

PSENTRY_GITHUB_OWNER=dceoy
PSENTRY_GITHUB_AUTHOR=dceoy
PSENTRY_PR_SEARCH_LIMIT=1000

PSENTRY_ORACLE_BIN=oracle
PSENTRY_ORACLE_MODEL=gpt-5.5-pro
PSENTRY_ORACLE_THINKING_TIME=extended
PSENTRY_ORACLE_MANUAL_LOGIN=1
PSENTRY_MAX_REVIEW_RUNTIME=1800

# Optional browser reattach tuning. Values are positive durations using
# milliseconds, seconds, minutes, or hours.
# PSENTRY_REATTACH_DELAY=30s
# PSENTRY_REATTACH_INTERVAL=2m
# PSENTRY_REATTACH_TIMEOUT=2m

# Native browser sessions may need these values copied from the graphical
# session. Export them because the executable loads this file directly.
# export DISPLAY=:0
# export XAUTHORITY=/home/your-user/.Xauthority
