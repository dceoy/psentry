# Copy to ~/.config/oracle-pr-sentry/env and chmod 600.
#
# oracle-pr-sentry validates this file before sourcing it as trusted Bash.
# Keep it user-owned and non-writable by group or other users.

ORACLE_PR_SENTRY_GITHUB_OWNER=dceoy
ORACLE_PR_SENTRY_GITHUB_AUTHOR=dceoy
ORACLE_PR_SENTRY_PR_SEARCH_LIMIT=50

ORACLE_PR_SENTRY_ORACLE_BIN=oracle
ORACLE_PR_SENTRY_ORACLE_MODEL=gpt-5.5-pro
ORACLE_PR_SENTRY_ORACLE_THINKING_TIME=extended
ORACLE_PR_SENTRY_ORACLE_MANUAL_LOGIN=1
ORACLE_PR_SENTRY_MAX_REVIEW_RUNTIME=1800

# Optional: one literal Oracle argument per line. See oracle-args.example.
# ORACLE_PR_SENTRY_ORACLE_ARGS_FILE=/home/your-user/.config/oracle-pr-sentry/oracle-args

# Browser services may need these values copied from the graphical session.
# Export them because the executable, rather than systemd, loads this file.
# export DISPLAY=:0
# export XAUTHORITY=/home/your-user/.Xauthority
